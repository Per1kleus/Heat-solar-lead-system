# Copy to .env and adjust. Every value has a working default in development.

NODE_ENV=development
PORT=4000

# Signs access tokens. Generate one with: openssl rand -hex 48
# If unset, a secret is generated into data/.secret on first boot.
VF_JWT_SECRET=

# Where the SQLite database, uploads and generated PDFs live.
VF_DATA_DIR=./server/data

# The public origin of the app, used in embed snippets and links.
VF_APP_URL=http://localhost:5173
VF_PUBLIC_URL=http://localhost:5173
VF_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional fallback AI key for single-tenant installs. Each organisation can
# instead supply its own key in Settings -> Communication.
ANTHROPIC_API_KEY=
VF_AI_MODEL=claude-opus-5

# How often the scheduler processes automation steps and overdue follow-ups.
VF_TICK_MS=60000
